Dataset running_analytics {
  label: 'Running & Training Analytics'
  description: 'Training load (CTL/ATL/TSB, ramp rate), volume and consistency, speed and progression, HR decoupling on long runs, environment effects, and cross-training mix. Grain: activities = one row per activity (all sports); weekly_summary = one row per week with intervals.icu fitness/fatigue/form; weekly_by_category = weekly volume per sport; decoupling_calc = computed HR decoupling for long runs.'
  data_source_name: 'running'

  models: [
    activities,
    weekly_summary,
    weekly_by_category,
    decoupling_calc,
  ]
  relationships: [
    relationship(decoupling_calc.activity_id > activities.id, true),
  ]

  metric total_activities {
    label: 'Total Activities'
    type: 'number'
    definition: @aql activities.activity_count ;;
  }
  metric total_time_h {
    label: 'Total Hours'
    type: 'number'
    definition: @aql activities.total_time_s / 3600.0 ;;
    format: '#,###0.0 "h"'
  }
  metric total_distance_km {
    label: 'Total Distance'
    type: 'number'
    definition: @aql activities.total_distance_m / 1000.0 ;;
    format: '#,###0 "km"'
  }
  metric total_elev_gain_m {
    label: 'Total Elevation Gain'
    type: 'number'
    definition: @aql activities.total_elev_gain_m ;;
    format: '#,###0 "m"'
  }
  metric total_load {
    label: 'Total Training Load'
    type: 'number'
    definition: @aql activities.total_load ;;
    format: '#,###0'
  }
  metric avg_pace_min_km {
    label: 'Avg Pace'
    type: 'number'
    description: 'Overall pace in min/km (moving time over distance).'
    definition: @aql activities.total_time_s / 60.0 / (activities.total_distance_m / 1000.0) ;;
    format: '#,###0.00 "min/km"'
  }
  metric avg_speed_kmh {
    label: 'Avg Speed'
    type: 'number'
    definition: @aql activities.total_distance_m / 1000.0 / (activities.total_time_s / 3600.0) ;;
    format: '#,###0.0 "km/h"'
  }
  metric weighted_avg_hr {
    label: 'Avg Heart Rate'
    type: 'number'
    description: 'Moving-time-weighted average heart rate.'
    definition: @aql (activities | sum(activities.avg_hr * activities.moving_time_s)) / activities.total_time_s ;;
    format: '#,##0 "bpm"'
  }
  metric avg_cadence {
    label: 'Avg Cadence'
    type: 'number'
    definition: @aql (activities | sum(activities.avg_cadence * activities.moving_time_s)) / activities.total_time_s ;;
    format: '#,##0 "spm"'
  }

  metric run_activities {
    label: 'Runs'
    type: 'number'
    definition: @aql activities.activity_count | where(activities.sport_group in ['run']) ;;
  }
  metric run_distance_km {
    label: 'Run Distance'
    type: 'number'
    definition: @aql (activities.total_distance_m / 1000.0) | where(activities.sport_group in ['run']) ;;
    format: '#,###0 "km"'
  }
  metric run_time_h {
    label: 'Run Hours'
    type: 'number'
    definition: @aql (activities.total_time_s / 3600.0) | where(activities.sport_group in ['run']) ;;
    format: '#,###0.0 "h"'
  }
  metric run_elev_gain_m {
    label: 'Run Elevation Gain'
    type: 'number'
    definition: @aql activities.total_elev_gain_m | where(activities.sport_group in ['run']) ;;
    format: '#,###0 "m"'
  }
  metric run_load {
    label: 'Run Load'
    type: 'number'
    definition: @aql activities.total_load | where(activities.sport_group in ['run']) ;;
    format: '#,###0'
  }
  metric run_pace_min_km {
    label: 'Run Pace'
    type: 'number'
    description: 'Pace in min/km across runs only.'
    definition: @aql run_time_h * 3600.0 / 60.0 / run_distance_km ;;
    format: '#,###0.00 "min/km"'
  }
  metric strength_time_h {
    label: 'Strength Hours'
    type: 'number'
    definition: @aql (activities.total_time_s / 3600.0) | where(activities.sport_group in ['strength']) ;;
    format: '#,###0.0 "h"'
  }
  metric ride_distance_km {
    label: 'Ride Distance'
    type: 'number'
    definition: @aql (activities.total_distance_m / 1000.0) | where(activities.sport_group in ['ride']) ;;
    format: '#,###0 "km"'
  }

  metric run_avg_cadence {
    label: 'Run Avg Cadence'
    type: 'number'
    description: 'Moving-time-weighted average cadence across runs (rpm, one-foot cycles/min).'
    definition: @aql ((activities | sum(activities.avg_cadence * activities.moving_time_s)) / activities.total_time_s) | where(activities.sport_group in ['run']) ;;
    format: '#,##0 "rpm"'
  }
  metric run_stride_m {
    label: 'Run Stride Length'
    type: 'number'
    description: 'Time-weighted average two-step stride length (m) across runs with usable cadence. Trail terrain shortens stride.'
    definition: @aql (activities | sum(activities.stride_m * activities.stride_time_s)) / (activities | sum(activities.stride_time_s)) | where(activities.sport_group in ['run']) ;;
    format: '#,##0.00 "m"'
  }
  metric run_elev_per_km {
    label: 'Run Elevation per km'
    type: 'number'
    description: 'Elevation gain per km across runs — a hilliness index. Trail runs rate far higher.'
    definition: @aql (activities | sum(activities.elev_gain_m)) / (activities | sum(activities.distance_m)) * 1000.0 | where(activities.sport_group in ['run']) ;;
    format: '#,##0 "m/km"'
  }
  metric run_aerobic_efficiency {
    label: 'Run Aerobic Efficiency'
    type: 'number'
    description: 'Time-weighted average speed (m/s) per average heart rate (bpm) across runs. Higher is more efficient.'
    definition: @aql (activities | sum(activities.avg_speed_ms * activities.moving_time_s)) / (activities | sum(activities.avg_hr * activities.moving_time_s)) | where(activities.sport_group in ['run']) ;;
    format: '#,##0.00'
  }

  metric cycling_activities {
    label: 'Rides'
    type: 'number'
    description: 'Activities with a ride type (road / virtual / mtb / gravel); e-bike rides excluded.'
    definition: @aql activities.activity_count | where(activities.ride_type is not null) ;;
  }
  metric cycling_distance_km {
    label: 'Ride Distance'
    type: 'number'
    description: 'Total km across typed rides (null distances contribute nothing).'
    definition: @aql (activities.total_distance_m / 1000.0) | where(activities.ride_type is not null) | where(activities.distance_m is not null) ;;
    format: '#,###0.0 "km"'
  }
  metric cycling_time_h {
    label: 'Ride Hours'
    type: 'number'
    description: 'Total moving hours across typed rides.'
    definition: @aql (activities.total_time_s / 3600.0) | where(activities.ride_type is not null) ;;
    format: '#,###0.0 "h"'
  }
  metric cycling_elev_gain_m {
    label: 'Ride Elevation Gain'
    type: 'number'
    description: 'Total metres climbed across typed rides with elevation data.'
    definition: @aql activities.total_elev_gain_m | where(activities.ride_type is not null) | where(activities.elev_gain_m is not null) ;;
    format: '#,###0 "m"'
  }
  metric cycling_weighted_watts {
    label: 'Ride Weighted Watts'
    type: 'number'
    description: 'Moving-time-weighted mean of weighted average power across typed rides with power.'
    definition: @aql ((activities | sum(activities.weighted_avg_watts * activities.moving_time_s)) / (activities | sum(activities.moving_time_s))) | where(activities.ride_type is not null) | where(activities.weighted_avg_watts is not null) ;;
    format: '#,###0 "W"'
  }
  metric cycling_if {
    label: 'Ride Intensity Factor'
    type: 'number'
    description: 'Moving-time-weighted mean of weighted_avg_watts / ftp_ref across typed rides with power and a per-activity FTP.'
    definition: @aql ((activities | sum(activities.weighted_avg_watts / activities.ftp_ref * activities.moving_time_s)) / (activities | sum(activities.moving_time_s))) | where(activities.ride_type is not null) | where(activities.weighted_avg_watts is not null) | where(activities.ftp_ref is not null) ;;
    format: '0.00'
  }
  metric cycling_avg_cadence {
    label: 'Ride Avg Cadence'
    type: 'number'
    description: 'Moving-time-weighted mean cadence (rpm) across typed rides with cadence > 40 rpm.'
    definition: @aql ((activities | sum(activities.avg_cadence * activities.moving_time_s)) / (activities | sum(activities.moving_time_s))) | where(activities.ride_type is not null) | where(activities.avg_cadence > 40) ;;
    format: '#,##0 "rpm"'
  }
  metric cycling_speed_kmh {
    label: 'Ride Avg Speed'
    type: 'number'
    description: 'Overall speed = total km / moving hours across typed rides with distance.'
    definition: @aql (activities.total_distance_m / 1000.0) / (activities.total_time_s / 3600.0) | where(activities.ride_type is not null) | where(activities.distance_m is not null) ;;
    format: '#,###0.0 "km/h"'
  }
  metric cycling_elev_per_km {
    label: 'Ride Hilliness'
    type: 'number'
    description: 'Elevation gain per km across typed rides with elevation data — a hilliness index.'
    definition: @aql (activities | sum(activities.elev_gain_m)) / (activities | sum(activities.distance_m)) * 1000.0 | where(activities.ride_type is not null) | where(activities.elev_gain_m is not null) ;;
    format: '#,##0 "m/km"'
  }

  view {
    group load {
      metric total_load
      metric run_load
    }
    group volume {
      metric total_distance_km
      metric total_time_h
      metric total_elev_gain_m
      metric run_distance_km
      metric run_time_h
      metric run_elev_gain_m
    }
    group speed {
      metric avg_pace_min_km
      metric run_pace_min_km
      metric avg_speed_kmh
      metric run_aerobic_efficiency
    }
    group physiology {
      metric weighted_avg_hr
      metric avg_cadence
      metric run_avg_cadence
    }
    group mix {
      metric total_activities
      metric run_activities
      metric strength_time_h
      metric ride_distance_km
    }
    group cycling {
      metric cycling_activities
      metric cycling_distance_km
      metric cycling_time_h
      metric cycling_elev_gain_m
      metric cycling_weighted_watts
      metric cycling_if
      metric cycling_avg_cadence
      metric cycling_speed_kmh
      metric cycling_elev_per_km
    }
  }
}
